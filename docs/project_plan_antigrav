## 4. Universal Data Model

To ensure consistency across TV, Anime, Movies, Manhwa, and custom feeds, all data is normalized into a single model:

```typescript
// frontend/src/types/media.ts
export type MediaType = 'tv' | 'movie' | 'anime' | 'manhwa' | 'custom_feed';

export interface ProviderLink {
  name: string;
  url: string;
}

export interface MediaItem {
  id: string;                      // e.g. "tmdb_tv_1399", "anilist_21", "feed_custom_1"
  source: 'tmdb' | 'anilist' | 'mangadex' | 'custom';
  mediaType: MediaType;
  title: string;
  originalTitle?: string;
  coverImage: string;
  bannerImage?: string;
  description: string;
  genres: string[];
  status: 'ongoing' | 'completed' | 'upcoming' | 'hiatus';
  
  // Release Tracking
  latestRelease: string;           // e.g. "Episode 12", "Chapter 104"
  latestReleaseNumber: number;     // Normalized numeric progress (12, 104)
  latestReleaseDate?: string;      // ISO 8601 string
  nextReleaseDate?: string;        // ISO 8601 string (null if completed or unknown)
  totalReleases?: number;          // Total episodes or chapters if known
  
  // Streaming / Reading Providers
  officialProviders: ProviderLink[];
}

export interface UserTrackedItem {
  mediaId: string;
  mediaItem: MediaItem;
  userProgress: number;            // Current episode or chapter reached
  isPinned: boolean;
  notes?: string;
  lastUpdated: string;             // ISO 8601
}

export interface OmniTrackStorage {
  version: string;                 // e.g. "1.0.0"
  lastModified: string;
  settings: {
    theme: 'dark' | 'light' | 'system';
    autoCheckIntervalMinutes: number;
    guestMode: boolean;
  };
  customFeeds: {
    id: string;
    name: string;
    url: string;
    mediaType: MediaType;
    lastFetched?: string;
  }[];
  trackedItems: Record<string, UserTrackedItem>;
}
```

